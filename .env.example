# Set automatically by the Neon integration in Vercel. Pull real values with:
#   vercel env pull .env.local
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# The company form ("For companies") writes to its own Neon database, winston-company-leads.
# Set by the same integration with the COMPANY_ prefix (Production and Preview only).
COMPANY_DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
